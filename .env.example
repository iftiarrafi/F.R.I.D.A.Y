# Groq API Key (Powers the main LLM via LangChain ChatGroq)
GROQ_API_KEY="your_groq_api_key_here"

# Tavily API Key (Powers the web search tool)
TAVLIY_API_KEY="your_tavily_api_key_here"

# Alpha Vantage API Key (Powers the real-time stock price lookup)
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key_here"

# OpenWeatherMap API Key (Powers geocoding and real-time weather reports)
OPENWEATHER_API_KEY="your_openweather_api_key_here"

# Google AI Studio API Key (Powers Gemini embeddings for RAG)
GOOGLE_API_KEY="your_google_ai_studio_api_key_here"

# LangSmith Tracing & Observability (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGSMITH_PROJECT="friday-agent"

